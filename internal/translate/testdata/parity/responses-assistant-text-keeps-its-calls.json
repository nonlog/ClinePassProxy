{
  "protocol": "openai-responses",
  "note": "CPA v8.0.4 merges tool calls back into the assistant text message of the same turn, so the upstream sees one assistant message with content and tool_calls instead of two.",
  "request": {
    "model": "gpt-5.6",
    "input": [
      { "type": "message", "role": "user", "content": [{ "type": "input_text", "text": "hi" }] },
      { "type": "message", "role": "assistant", "content": [{ "type": "output_text", "text": "Checking." }] },
      { "type": "function_call", "call_id": "call_a", "name": "lookup", "arguments": "{}" },
      { "type": "function_call_output", "call_id": "call_a", "output": "42" }
    ]
  },
  "expected": {
    "model": "upstream-model",
    "stream": true,
    "messages": [
      { "role": "user", "content": [{ "type": "text", "text": "hi" }] },
      {
        "role": "assistant",
        "content": [{ "type": "text", "text": "Checking." }],
        "tool_calls": [
          {
            "id": "call_a",
            "type": "function",
            "function": { "name": "lookup", "arguments": "{}" }
          }
        ]
      },
      { "role": "tool", "tool_call_id": "call_a", "content": "42" }
    ]
  }
}
