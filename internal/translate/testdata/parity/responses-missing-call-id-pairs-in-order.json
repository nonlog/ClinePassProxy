      { "type": "function_call_output", "output": "result one" },
      { "type": "function_call_output", "output": "result two" }
    ]
  },
  "expected": {
    "model": "upstream-model",
    "stream": true,
    "messages": [
      {
        "role": "assistant",
        "content": "",
        "tool_calls": [
          { "id": "call_a", "type": "function", "function": { "name": "first", "arguments": "{}" } },
          { "id": "call_b", "type": "function", "function": { "name": "second", "arguments": "{}" } }
        ]
      },
